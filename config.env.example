# adsb-node-bootstrap configuration
# Copy to config.env and edit before running bootstrap.sh
# All values can also be passed as environment variables

# === REQUIRED: Receiver location ===
LATITUDE=""              # Decimal degrees (e.g. 32.8998)
LONGITUDE=""             # Decimal degrees (e.g. -97.0403)
ALTITUDE_FT=""           # Antenna altitude in feet above mean sea level
# ALTITUDE_M=""          # Or specify in meters — script converts either way

# === Identity ===
MLAT_SITE_NAME=""        # Shown on the aggregators' MLAT maps (default: hostname)
NODE_HOSTNAME=""         # Optional: set the system hostname
TIMEZONE=""              # Optional: e.g. "Europe/London" (NTP is always enabled)

# === Aggregator feeds (yes/no) ===
# Priority if bandwidth-limited: adsb.lol > FA > adsb.fi > ADSBx > airplanes.live > OpenSky
FEED_ADSBLOL="yes"
FEED_FLIGHTAWARE="yes"
FEED_ADSBFI="yes"
FEED_ADSBX="yes"
FEED_AIRPLANESLIVE="yes"
FEED_OPENSKY="no"
FEED_FR24="no"               # FlightRadar24 (opt-in, interactive signup — skipped when unattended)
# OPENSKY_USERNAME=""        # Your OpenSky account name, if you already have one

# === MLAT + UAT ===
ENABLE_MLAT="yes"
ENABLE_UAT="no"              # 978 MHz UAT decoder (US only, needs second SDR)

# === SDR device serial pinning ===
# Leave blank for auto-detect (single dongle).
# MUST be set if you have multiple SDRs — program with: rtl_eeprom -s "serial"
SDR_SERIAL_1090=""            # 1090ES dongle (e.g. "stx:1090:0")
SDR_SERIAL_978=""             # 978 UAT dongle (e.g. "stx:978:0")

# === Advanced ===
# NODE_USER="adsb"           # System user (for cloud-init reference)
# READSB_GAIN="-10"          # SDR gain (-10 = AGC, or fixed like 49.6)
# BEAST_BIND_PORT="30005"    # Beast output port
# SKIP_SYSTEM_UPDATE="no"    # Skip apt update/upgrade (for faster re-runs)
# FORCE_REINSTALL="no"       # Rebuild feeds that are already running
# LOG_FILE="/var/log/adsb-bootstrap.log"
# RESTORE_UUIDS=""           # Path to a saved uuids.env to restore station identities (see README "Reimaging")
